<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <TailwindExecutable Condition="'$(TailwindExecutable)' == ''">tailwindcss</TailwindExecutable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PencePerLitre.Shared\PencePerLitre.Shared.csproj" />
  </ItemGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="Build">
    <Exec Command="&quot;$(TailwindExecutable)&quot; -i Styles/app.css -o wwwroot/css/app.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
