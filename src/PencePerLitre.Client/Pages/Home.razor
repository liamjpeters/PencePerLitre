@page "/"
@inject FuelDataService FuelService
@inject GeoLocationService GeoService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Pence Per Litre | Live UK Fuel Prices</PageTitle>

<div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top Filter Bar -->
    <div class="bg-white dark:bg-neutral-950 border-b border-neutral-200 dark:border-neutral-800 z-20 px-4 py-3 flex-shrink-0 transition-colors">
        <div class="max-w-7xl mx-auto space-y-3">
            <!-- Row 1: Search + Fuel Type Selector -->
            <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3 justify-between">
                <!-- Search Input Group -->
                <div class="flex items-center gap-2 flex-1 max-w-lg">
                    <div class="relative flex-1">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-neutral-400 dark:text-neutral-500 text-sm">
                            🔍
                        </span>
                        <input type="text" 
                               @bind="searchQuery" 
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown"
                               placeholder="Enter UK Postcode (e.g. S1 1AA, SW1A)..."
                               class="w-full pl-9 pr-3 py-2 bg-neutral-100/70 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg text-neutral-950 dark:text-neutral-100 placeholder:text-neutral-400 dark:placeholder:text-neutral-600 text-sm font-medium focus:ring-2 focus:ring-neutral-400 dark:focus:ring-neutral-600 focus:outline-none transition-all" />
                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <button @onclick="ClearSearch" class="absolute inset-y-0 right-0 pr-3 flex items-center text-neutral-400 hover:text-neutral-950 dark:hover:text-neutral-100">
                                ✕
                            </button>
                        }
                    </div>

                    <button @onclick="SearchByPostcode" 
                            disabled="@isSearching"
                            class="px-4 py-2 bg-neutral-950 hover:bg-neutral-800 dark:bg-neutral-100 dark:hover:bg-white text-white dark:text-neutral-950 text-sm font-semibold rounded-lg transition-colors disabled:opacity-50">
                        Search
                    </button>

                    <button @onclick="UseCurrentLocation" 
                            disabled="@isSearching"
                            title="Find fuel near my current GPS location"
                            class="px-3 py-2 bg-transparent hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700 rounded-lg text-sm font-semibold flex items-center gap-1.5 transition-colors whitespace-nowrap">
                        <span>📍</span>
                        <span class="hidden sm:inline">Near Me</span>
                    </button>
                </div>

                <!-- Fuel Type Pill Selector -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 no-scrollbar">
                    @foreach (var fuel in supportedFuels)
                    {
                        var isSelected = selectedFuelType == fuel.Key;
                        <button @onclick="() => SelectFuelType(fuel.Key)"
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors @(isSelected ? "bg-neutral-950 dark:bg-neutral-100 text-white dark:text-neutral-950" : "bg-neutral-100 dark:bg-neutral-900 hover:bg-neutral-200 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400")">
                            @fuel.Value
                        </button>
                    }
                </div>
            </div>

            <!-- Row 2: Secondary Filters & View Toggles -->
            <div class="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-neutral-100 dark:border-neutral-900 text-xs">
                <!-- Radius & Sort -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5 text-neutral-600 dark:text-neutral-400">
                        <span class="font-medium">Radius:</span>
                        <select @bind="selectedRadius" @bind:after="ApplyFilters" class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md px-2 py-1 text-xs font-medium text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-neutral-400 dark:focus:ring-neutral-600">
                            <option value="3">3 miles</option>
                            <option value="5">5 miles</option>
                            <option value="10">10 miles</option>
                            <option value="15">15 miles</option>
                            <option value="25">25 miles</option>
                            <option value="50">50 miles</option>
                        </select>
                    </div>

                    <div class="flex items-center gap-1.5 text-neutral-600 dark:text-neutral-400">
                        <span class="font-medium">Sort:</span>
                        <select @bind="selectedSort" @bind:after="ApplyFilters" class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md px-2 py-1 text-xs font-medium text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-neutral-400 dark:focus:ring-neutral-600">
                            <option value="price">Cheapest First</option>
                            <option value="distance">Nearest First</option>
                            @if (vehicleSettings.Enabled)
                            {
                                <option value="effective">Effective Price</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Toggles & Mobile Switcher -->
                <div class="flex items-center gap-2">
                    <label class="flex items-center gap-1 cursor-pointer text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-neutral-100 select-none">
                        <input type="checkbox" @bind="supermarketOnly" @bind:after="ApplyFilters" class="rounded accent-neutral-950 dark:accent-neutral-100" />
                        <span>Supermarkets</span>
                    </label>

                    <label class="flex items-center gap-1 cursor-pointer text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-neutral-100 select-none ml-2">
                        <input type="checkbox" @bind="open24hOnly" @bind:after="ApplyFilters" class="rounded accent-neutral-950 dark:accent-neutral-100" />
                        <span>24 Hours</span>
                    </label>

                    <label class="flex items-center gap-1 cursor-pointer text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-neutral-100 select-none ml-2">
                        <input type="checkbox" @bind="vehicleSettings.Enabled" @bind:after="ToggleEffectivePricingAsync" class="rounded accent-neutral-950 dark:accent-neutral-100" />
                        <span>Journey cost</span>
                    </label>

                    <!-- Mobile List/Map View Toggle -->
                    <div class="flex md:hidden items-center bg-neutral-100 dark:bg-neutral-900 p-0.5 rounded-lg ml-2">
                        <button @onclick="() => mobileViewMode = MobileView.List" 
                                class="px-2.5 py-1 rounded-md text-xs font-semibold transition-colors @(mobileViewMode == MobileView.List ? "bg-white dark:bg-neutral-700 text-neutral-950 dark:text-neutral-50 shadow-xs" : "text-neutral-500")">
                            List
                        </button>
                        <button @onclick="() => mobileViewMode = MobileView.Map" 
                                class="px-2.5 py-1 rounded-md text-xs font-semibold transition-colors @(mobileViewMode == MobileView.Map ? "bg-white dark:bg-neutral-700 text-neutral-950 dark:text-neutral-50 shadow-xs" : "text-neutral-500")">
                            Map
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (vehicleSettings.Enabled)
        {
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-neutral-100 dark:border-neutral-900 pt-3 flex flex-col lg:flex-row lg:items-end gap-3 text-xs">
                <div class="flex-1">
                    <div class="font-semibold text-neutral-800 dark:text-neutral-200">Estimated effective price</div>
                    <p class="text-neutral-500 dark:text-neutral-400 mt-0.5">Assumes a return journey and filling the tank. Distance is approximate.</p>
                </div>
                <label class="flex flex-col gap-1 text-neutral-600 dark:text-neutral-400">
                    <span>Tank capacity (litres)</span>
                    <input type="number" min="1" step="1" @bind="vehicleSettings.TankCapacityLitres" @bind:event="oninput" @bind:after="VehicleSettingsChangedAsync"
                           class="w-32 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md px-2 py-1.5 text-neutral-950 dark:text-neutral-100 focus:outline-none focus:ring-1 focus:ring-neutral-400" />
                </label>
                <label class="flex flex-col gap-1 text-neutral-600 dark:text-neutral-400">
                    <span>@(vehicleSettings.UseMetric ? "Efficiency (L/100 km)" : "Efficiency (UK MPG)")</span>
                    <input type="number" min="0.1" step="0.1" @bind="vehicleSettings.Efficiency" @bind:event="oninput" @bind:after="VehicleSettingsChangedAsync"
                           class="w-32 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-md px-2 py-1.5 text-neutral-950 dark:text-neutral-100 focus:outline-none focus:ring-1 focus:ring-neutral-400" />
                </label>
                <div class="flex items-center bg-neutral-100 dark:bg-neutral-900 rounded-md p-0.5 h-8">
                    <button @onclick="() => SetEfficiencyUnitAsync(false)" class="px-2.5 h-7 rounded text-[11px] font-semibold @(vehicleSettings.UseMetric ? "text-neutral-500" : "bg-white dark:bg-neutral-700 text-neutral-950 dark:text-neutral-50 shadow-xs")">UK MPG</button>
                    <button @onclick="() => SetEfficiencyUnitAsync(true)" class="px-2.5 h-7 rounded text-[11px] font-semibold @(vehicleSettings.UseMetric ? "bg-white dark:bg-neutral-700 text-neutral-950 dark:text-neutral-50 shadow-xs" : "text-neutral-500")">L/100 km</button>
                </div>
                @if (!VehicleSettingsValid)
                {
                    <p class="text-red-600 dark:text-red-400 lg:max-w-48">Enter positive tank capacity and efficiency values to calculate effective prices.</p>
                }
            </div>
        }
    </div>

    <!-- Error/Status Bar if any -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="bg-neutral-100 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800 px-4 py-2 text-xs text-neutral-700 dark:text-neutral-300 flex items-center justify-between z-10">
            <span class="flex items-center gap-1.5 font-medium">
                <span>⚠️</span> @statusMessage
            </span>
            <button @onclick="() => statusMessage = null" class="text-neutral-500 hover:text-neutral-950 dark:hover:text-neutral-50 font-bold">✕</button>
        </div>
    }

    <!-- Main Content Body: Split View -->
    <div class="flex-1 flex overflow-hidden relative">
        <!-- Left Column: Results List -->
        <div class="w-full md:w-[480px] lg:w-[540px] flex flex-col border-r border-neutral-200 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-950 flex-shrink-0 @(mobileViewMode == MobileView.Map ? "hidden md:flex" : "flex")">
            <!-- Results Header Summary -->
            <div class="px-4 py-2.5 bg-neutral-100 dark:bg-neutral-900/70 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-xs text-neutral-600 dark:text-neutral-400 font-medium">
                <span>
                    @if (currentLocationName != null)
                    {
                        <span>Near <strong>@currentLocationName</strong>: </span>
                    }
                    <strong>@filteredStations.Count</strong> station@(filteredStations.Count == 1 ? "" : "s") found
                </span>

                @if (vehicleSettings.Enabled && cheapestEffectivePrice != null)
                {
                    <span class="text-neutral-950 dark:text-neutral-100 font-bold bg-white dark:bg-neutral-800 px-2 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-700">
                        Lowest effective: @cheapestEffectivePrice.Value.ToString("0.0")p
                    </span>
                }
                else if (cheapestPrice != null)
                {
                    <span class="text-neutral-950 dark:text-neutral-100 font-bold bg-white dark:bg-neutral-800 px-2 py-0.5 rounded-full border border-neutral-200 dark:border-neutral-700">
                        Lowest: @cheapestPrice.Value.ToString("0.0")p
                    </span>
                }
            </div>

            <!-- Scrollable Stations List -->
            <div class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-3">
                @if (!filteredStations.Any())
                {
                    <div class="h-64 flex flex-col items-center justify-center text-center p-6 bg-white dark:bg-neutral-900 rounded-lg border border-dashed border-neutral-300 dark:border-neutral-700">
                        <span class="text-4xl mb-2">🔍</span>
                        <h4 class="font-bold text-neutral-900 dark:text-neutral-100 text-base">No stations found nearby</h4>
                        <p class="text-xs text-neutral-500 dark:text-neutral-400 max-w-xs mt-1">
                            Try increasing your search radius or entering a different UK postcode.
                        </p>
                        <button @onclick="async () => { selectedRadius = 25; await ApplyFilters(); }" 
                                class="mt-4 px-4 py-1.5 bg-neutral-950 dark:bg-neutral-100 text-white dark:text-neutral-950 rounded-lg text-xs font-semibold hover:bg-neutral-800 dark:hover:bg-white">
                            Expand radius to 25 miles
                        </button>
                    </div>
                }
                else
                {
                    @foreach (var item in filteredStations)
                    {
                        var isCheapest = vehicleSettings.Enabled && cheapestEffectivePrice != null
                            ? item.EffectivePrice == cheapestEffectivePrice
                            : cheapestPrice != null && item.SelectedFuelPrice == cheapestPrice;
                        <div class="bg-white dark:bg-neutral-900 rounded-lg p-4 border transition-colors cursor-pointer hover:border-neutral-400 dark:hover:border-neutral-600 @(isCheapest ? "border-neutral-950 dark:border-neutral-100 ring-1 ring-neutral-950 dark:ring-neutral-100" : "border-neutral-200 dark:border-neutral-800")"
                             @onclick="() => OpenStationDetails(item)">
                            
                            <div class="flex items-start justify-between gap-3">
                                <!-- Station Name & Details -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="px-2 py-0.5 rounded-md text-[11px] font-bold @GetBrandBadgeColor(item.Station.Brand)">
                                            @(string.IsNullOrWhiteSpace(item.Station.Brand) ? "Independent" : item.Station.Brand)
                                        </span>
                                        @if (item.Station.Supermarket)
                                        {
                                            <span class="text-[10px] bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 px-1.5 py-0.5 rounded font-medium">Supermarket</span>
                                        }
                                        @if (item.Station.Motorway)
                                        {
                                            <span class="text-[10px] bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 px-1.5 py-0.5 rounded font-medium">Motorway</span>
                                        }
                                    </div>

                                    <h3 class="font-bold text-neutral-950 dark:text-neutral-100 text-sm mt-1 truncate">
                                        @item.Station.Name
                                    </h3>

                                    <p class="text-xs text-neutral-500 dark:text-neutral-400 truncate mt-0.5">
                                        @item.Station.Address
                                    </p>

                                    <div class="flex items-center gap-3 mt-2 text-xs text-neutral-500 dark:text-neutral-400">
                                        @if (item.DistanceMiles.HasValue)
                                        {
                                            <span class="font-semibold text-neutral-700 dark:text-neutral-300 flex items-center gap-1">
                                                <span>🚗</span> @item.DistanceMiles.Value.ToString("0.0") miles
                                            </span>
                                        }
                                        <span>•</span>
                                        <span>@item.Station.Postcode</span>
                                    </div>
                                </div>

                                <!-- Price Display Box -->
                                <div class="flex flex-col items-end flex-shrink-0">
                                    @if (item.SelectedFuelPrice.HasValue)
                                    {
                                        <div class="px-3 py-1.5 rounded-lg text-center bg-neutral-950 dark:bg-neutral-100 text-white dark:text-neutral-950">
                                            <div class="text-base sm:text-lg font-black tracking-tight leading-tight">
                                                @item.SelectedFuelPrice.Value.ToString("0.0")<span class="text-xs font-normal">p</span>
                                            </div>
                                            <div class="text-[9px] opacity-80 uppercase tracking-wider font-semibold">
                                                @FuelTypeConstants.GetDisplayName(selectedFuelType).Split('(')[0].Trim()
                                            </div>
                                            @if (vehicleSettings.Enabled && item.EffectivePrice.HasValue)
                                            {
                                                <div class="text-[10px] mt-1 opacity-90 font-semibold">
                                                    Effective @item.EffectivePrice.Value.ToString("0.0")p
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-neutral-400 dark:text-neutral-500 italic bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-md">Price N/A</span>
                                    }
                                </div>
                            </div>

                            <!-- Card Footer: Quick Actions -->
                            <div class="mt-3 pt-2.5 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
                                <div class="flex items-center gap-1.5 text-[11px] text-neutral-400 dark:text-neutral-500">
                                    @if (item.Prices.TryGetValue(selectedFuelType, out var pDto) && !string.IsNullOrEmpty(pDto.Updated))
                                    {
                                        <span>Updated @FormatTimeAgo(pDto.Updated)</span>
                                    }
                                </div>

                                <div class="flex items-center gap-2">
                                    <button @onclick:stopPropagation="true"
                                            @onclick="() => FocusOnMap(item.Station.Lat, item.Station.Lon)"
                                            class="text-neutral-700 hover:text-neutral-950 dark:text-neutral-300 dark:hover:text-neutral-50 font-semibold px-2 py-1 rounded hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                                        View on Map 📍
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Column: Interactive Leaflet Map -->
        <div class="flex-1 relative overflow-hidden @(mobileViewMode == MobileView.List ? "hidden md:block" : "block")">
            <div id="fuel-map" class="absolute inset-0"></div>
        </div>
    </div>

    <!-- Station Details Modal -->
    @if (selectedStation != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs animate-fadeIn">
            <div class="bg-white dark:bg-neutral-900 rounded-lg max-w-lg w-full p-6 shadow-2xl border border-neutral-200 dark:border-neutral-800 max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
                <!-- Modal Header -->
                <div class="flex items-start justify-between pb-3 border-b border-neutral-200 dark:border-neutral-800">
                    <div>
                        <span class="px-2 py-0.5 rounded text-xs font-bold @GetBrandBadgeColor(selectedStation.Station.Brand)">
                            @(string.IsNullOrWhiteSpace(selectedStation.Station.Brand) ? "Independent" : selectedStation.Station.Brand)
                        </span>
                        <h3 class="text-lg font-bold text-neutral-950 dark:text-neutral-100 mt-1">@selectedStation.Station.Name</h3>
                        <p class="text-xs text-neutral-500 dark:text-neutral-400">@selectedStation.Station.Address, @selectedStation.Station.Postcode</p>
                        @if (vehicleSettings.Enabled && selectedStation.EffectivePrice.HasValue)
                        {
                            <p class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 mt-2">
                                Estimated effective price: @selectedStation.EffectivePrice.Value.ToString("0.0")p
                            </p>
                        }
                    </div>
                    <button @onclick="() => selectedStation = null" class="text-neutral-400 hover:text-neutral-950 dark:hover:text-neutral-50 text-xl font-bold p-1">
                        ✕
                    </button>
                </div>

                <!-- Fuel Prices Table -->
                <div class="mt-4">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-2">Live Fuel Prices (Pence Per Litre)</h4>
                    @if (selectedStation.Prices.Any())
                    {
                        <div class="bg-neutral-50 dark:bg-neutral-950 rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-800">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700">
                                    <tr>
                                        <th class="py-2 px-3 font-semibold">Fuel Grade</th>
                                        <th class="py-2 px-3 font-semibold text-right">Price</th>
                                        <th class="py-2 px-3 font-semibold text-right">Last Updated</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
                                    @foreach (var p in selectedStation.Prices.OrderBy(x => x.Key))
                                    {
                                        <tr class="hover:bg-white dark:hover:bg-neutral-800 transition-colors">
                                            <td class="py-2.5 px-3 font-medium text-neutral-800 dark:text-neutral-200">
                                                @FuelTypeConstants.GetDisplayName(p.Key)
                                            </td>
                                            <td class="py-2.5 px-3 font-bold text-neutral-950 dark:text-neutral-100 text-right text-sm">
                                                @p.Value.Price.ToString("0.0")p
                                            </td>
                                            <td class="py-2.5 px-3 text-neutral-400 dark:text-neutral-500 text-right text-[11px]">
                                                @(string.IsNullOrEmpty(p.Value.Updated) ? "Recent" : FormatTimeAgo(p.Value.Updated))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-neutral-400 dark:text-neutral-500 italic">No live price reports recorded for this station yet.</p>
                    }
                </div>

                <!-- Opening Hours & Amenities -->
                <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div>
                        <h4 class="font-bold text-neutral-700 dark:text-neutral-300 mb-1.5">🕒 Opening Hours</h4>
                        @if (selectedStation.Station.Opening?.UsualDays != null)
                        {
                            <div class="space-y-1 text-neutral-600 dark:text-neutral-400">
                                @foreach (var day in selectedStation.Station.Opening.UsualDays)
                                {
                                    <div class="flex justify-between">
                                        <span class="capitalize">@day.Key:</span>
                                        <span class="font-medium">@(day.Value.Is24Hours ? "24 Hours" : $"{day.Value.Open} - {day.Value.Close}")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-neutral-400 dark:text-neutral-500">Hours not specified</span>
                        }
                    </div>

                    <div>
                        <h4 class="font-bold text-neutral-700 dark:text-neutral-300 mb-1.5">✨ Amenities</h4>
                        @if (selectedStation.Station.Amenities != null && selectedStation.Station.Amenities.Any())
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var amenity in selectedStation.Station.Amenities)
                                {
                                    <span class="px-2 py-0.5 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 rounded text-[10px] capitalize">
                                        @amenity.Replace("_", " ")
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-neutral-400 dark:text-neutral-500">Standard forecourt facilities</span>
                        }
                    </div>
                </div>

                <!-- Modal Actions -->
                <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-3">
                    <a href="https://www.fuel-finder.service.gov.uk/motorist/price-report" target="_blank"
                       class="text-[11px] text-neutral-500 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-neutral-50 underline flex items-center gap-1">
                        <span>📢</span> Report Price Discrepancy (Gov.UK)
                    </a>

                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <a href="https://www.google.com/maps/dir/?api=1&destination=@selectedStation.Station.Lat,@selectedStation.Station.Lon" 
                           target="_blank"
                           class="flex-1 sm:flex-none px-4 py-2 bg-neutral-950 hover:bg-neutral-800 dark:bg-neutral-100 dark:hover:bg-white text-white dark:text-neutral-950 font-semibold rounded-lg text-xs flex items-center justify-center gap-1.5 transition-colors">
                            <span>🧭</span> Get Directions
                        </a>
                        <button @onclick="() => selectedStation = null" class="px-4 py-2 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-semibold rounded-lg text-xs transition-colors">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum MobileView { List, Map }
    private MobileView mobileViewMode = MobileView.List;

    private bool isSearching = false;
    private string? statusMessage;

    private string searchQuery = "";
    private string? currentLocationName = null;
    private double currentLat = 51.5074; // Default to London centre (map only, no search run)
    private double currentLon = -0.1278;

    private string selectedFuelType = FuelTypeConstants.E10;
    private double selectedRadius = 10.0;
    private string selectedSort = "price";
    private bool supermarketOnly = false;
    private bool open24hOnly = false;

    private List<StationViewItem> filteredStations = new();
    private StationViewItem? selectedStation;
    private double? cheapestPrice;
    private double? cheapestEffectivePrice;
    private VehicleSettings vehicleSettings = new();
    private bool VehicleSettingsValid => vehicleSettings.TankCapacityLitres > 0 && vehicleSettings.Efficiency > 0;

    private DotNetObjectReference<object>? dotNetHelper;

    private readonly Dictionary<string, string> supportedFuels = new()
    {
        { FuelTypeConstants.E10, "Unleaded (E10)" },
        { FuelTypeConstants.E5, "Super Unleaded (E5)" },
        { FuelTypeConstants.B7Standard, "Diesel (B7)" },
        { FuelTypeConstants.B7Premium, "Premium Diesel" },
        { FuelTypeConstants.HVO, "HVO Diesel" }
    };

    protected override async Task OnInitializedAsync()
    {
        dotNetHelper = DotNetObjectReference.Create<object>(this);

        try
        {
            var storedSettings = await JS.InvokeAsync<VehicleSettings?>("pencePerLitreVehicleSettings.load");
            if (storedSettings != null)
            {
                vehicleSettings = storedSettings;
            }
        }
        catch
        {
            // Use defaults if browser storage is unavailable.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // 1. Initialize Map (UK overview)
                await GeoService.InitMapAsync("fuel-map", dotNetHelper!, 54.5, -3.5, 6);

                // 2. Only run initial search if there's a query already set
                if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    await SearchByPostcode();
                }

                // 3. Force MapLibre to recalculate map size now the DOM has settled
                await Task.Delay(150);
                await GeoService.InvalidateMapSizeAsync();
            }
            catch (Exception ex)
            {
                statusMessage = $"Failed to initialise the map: {ex.Message}";
            }
            StateHasChanged();
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchByPostcode();
        }
    }

    private void ClearSearch()
    {
        searchQuery = "";
    }

    private async Task SearchByPostcode()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;

        isSearching = true;
        statusMessage = null;

        try
        {
            var res = await GeoService.LookupPostcodeAsync(searchQuery.Trim());
            if (res.Success)
            {
                currentLat = res.Lat;
                currentLon = res.Lon;
                currentLocationName = res.Postcode ?? searchQuery.ToUpperInvariant();
                await ApplyFilters();
                await GeoService.SetMapViewAsync(currentLat, currentLon, 12);
            }
            else
            {
                statusMessage = res.Error
                    ?? $"Postcode not found: '{searchQuery}'. Please enter a valid UK postcode (e.g. S1 1AA).";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error resolving postcode: {ex.Message}";
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task UseCurrentLocation()
    {
        isSearching = true;
        statusMessage = null;

        try
        {
            var pos = await GeoService.GetCurrentLocationAsync();
            if (pos.Success)
            {
                currentLat = pos.Lat;
                currentLon = pos.Lon;
                currentLocationName = "Your Location";
                searchQuery = "";
                await ApplyFilters();
                await GeoService.SetMapViewAsync(currentLat, currentLon, 13);
            }
            else
            {
                statusMessage = pos.Error ?? "Could not access your location.";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error getting location: {ex.Message}";
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task SelectFuelType(string fuelType)
    {
        selectedFuelType = fuelType;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        filteredStations = FuelService.Search(
            currentLat,
            currentLon,
            selectedRadius,
            selectedFuelType,
            supermarketOnly,
            false,
            open24hOnly,
            selectedSort,
            vehicleSettings.Enabled ? vehicleSettings : null
        );

        cheapestPrice = filteredStations
            .Where(s => s.SelectedFuelPrice.HasValue)
            .Select(s => s.SelectedFuelPrice)
            .DefaultIfEmpty(null)
            .Min();

        cheapestEffectivePrice = filteredStations
            .Where(s => s.EffectivePrice.HasValue)
            .Select(s => s.EffectivePrice)
            .DefaultIfEmpty(null)
            .Min();

        // Update map markers
        await GeoService.UpdateMapMarkersAsync(filteredStations, (currentLat, currentLon));
    }

    private async Task ToggleEffectivePricingAsync()
    {
        if (!vehicleSettings.Enabled && selectedSort == "effective")
        {
            selectedSort = "price";
        }

        await SaveVehicleSettingsAsync();
        await ApplyFilters();
    }

    private async Task VehicleSettingsChangedAsync()
    {
        await SaveVehicleSettingsAsync();
        if (vehicleSettings.Enabled)
        {
            await ApplyFilters();
        }
    }

    private async Task SetEfficiencyUnitAsync(bool useMetric)
    {
        if (vehicleSettings.UseMetric == useMetric)
        {
            return;
        }

        if (vehicleSettings.Efficiency > 0)
        {
            vehicleSettings.Efficiency = 282.481 / vehicleSettings.Efficiency;
        }

        vehicleSettings.UseMetric = useMetric;
        await VehicleSettingsChangedAsync();
    }

    private async Task SaveVehicleSettingsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("pencePerLitreVehicleSettings.save", vehicleSettings);
        }
        catch
        {
            // Local storage is optional and unavailable in some browsing modes.
        }
    }

    private async Task FocusOnMap(double lat, double lon)
    {
        mobileViewMode = MobileView.Map;
        await GeoService.SetMapViewAsync(lat, lon, 15);
    }

    private void OpenStationDetails(StationViewItem item)
    {
        selectedStation = item;
    }

    [JSInvokable]
    public void OnStationMarkerClicked(string stationId)
    {
        var item = filteredStations.FirstOrDefault(s => s.Station.Id == stationId);
        if (item != null)
        {
            selectedStation = item;
            StateHasChanged();
        }
    }

    private static string GetBrandBadgeColor(string? brand)
    {
        var b = (brand ?? "").ToLowerInvariant();
        if (b.Contains("shell")) return "bg-yellow-100 text-yellow-800 border border-yellow-300";
        if (b.Contains("bp")) return "bg-emerald-100 text-emerald-800 border border-emerald-300";
        if (b.Contains("esso")) return "bg-red-100 text-red-800 border border-red-300";
        if (b.Contains("tesco")) return "bg-blue-100 text-blue-800 border border-blue-300";
        if (b.Contains("asda")) return "bg-lime-100 text-lime-800 border border-lime-300";
        if (b.Contains("morrisons")) return "bg-yellow-100 text-yellow-900 border border-yellow-300";
        if (b.Contains("sainsbury")) return "bg-orange-100 text-orange-800 border border-orange-300";
        if (b.Contains("texaco")) return "bg-red-100 text-red-900 border border-red-300";
        if (b.Contains("jet")) return "bg-amber-100 text-amber-900 border border-amber-300";
        if (b.Contains("applegreen")) return "bg-emerald-100 text-emerald-900 border border-emerald-300";
        return "bg-slate-100 text-slate-800 border border-slate-300";
    }

    private static string FormatTimeAgo(string isoDate)
    {
        if (DateTime.TryParse(isoDate, out var dt))
        {
            var span = DateTime.UtcNow - dt.ToUniversalTime();
            if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
            if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
            return $"{(int)span.TotalDays}d ago";
        }
        return "Recent";
    }

    public async ValueTask DisposeAsync()
    {
        dotNetHelper?.Dispose();
    }
}
